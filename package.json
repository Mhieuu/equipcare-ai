{
  "name": "equipcare-ai",
  "version": "0.1.0",
  "private": true,
  "description": "AI-Powered Equipment Maintenance Management System - P1 MVP",
  "engines": {
    "node": ">=20.10.0",
    "pnpm": ">=9"
  },
  "packageManager": "pnpm@9.12.0",
  "scripts": {
    "dev": "pnpm -r --parallel --stream dev",
    "build": "pnpm -r build",
    "lint": "pnpm -r lint",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "test:e2e": "pnpm --filter @equipcare/api test:e2e",
    "test:ux": "pnpm --filter @equipcare/web test:ux",
    "db:migrate:dev": "pnpm --filter @equipcare/api prisma:migrate:dev",
    "db:migrate:deploy": "pnpm --filter @equipcare/api prisma:migrate:deploy",
    "db:seed": "pnpm --filter @equipcare/api prisma:seed",
    "db:reset": "pnpm --filter @equipcare/api prisma:reset",
    "infra:up": "docker compose -f infra/docker-compose.yml up -d",
    "infra:down": "docker compose -f infra/docker-compose.yml down",
    "demo": "bash scripts/demo-flow.sh"
  }
}