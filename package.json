{
  "name": "equipcare-ai",
  "version": "1.0.0",
  "private": true,
  "description": "AI-Powered Equipment Maintenance Management System — DATN",
  "packageManager": "pnpm@9.12.0",
  "engines": {
    "node": ">=22.0.0 <23.0.0",
    "pnpm": ">=9.12.0"
  },
  "scripts": {
    "infra:up": "docker compose -f infra/docker-compose.infra.yml up -d",
    "infra:down": "docker compose -f infra/docker-compose.infra.yml down",
    "infra:logs": "docker compose -f infra/docker-compose.infra.yml logs -f",
    "demo:up": "docker compose -f infra/docker-compose.demo.yml up -d",
    "demo:down": "docker compose -f infra/docker-compose.demo.yml down",
    "dev": "pnpm -r --parallel --filter \"./apps/*\" run dev",
    "build": "pnpm -r --filter \"./apps/*\" --filter \"./packages/*\" run build",
    "lint": "pnpm -r --filter \"./apps/*\" --filter \"./packages/*\" run lint",
    "typecheck": "pnpm -r --filter \"./apps/*\" --filter \"./packages/*\" run typecheck",
    "test": "pnpm -r --filter \"./apps/*\" --filter \"./packages/*\" run test"
  }
}
