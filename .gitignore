# =============================================================================
# EquipCare AI — gitignore
# Monorepo: apps/api (NestJS) + apps/web (Next.js) + apps/worker (BullMQ)
# =============================================================================

# ---- Node / pnpm ----
node_modules/
.pnpm-store/
.pnpm-debug.log*
npm-debug.log*

# ---- Test logs (regenerated by tests) ----
*.log
e2e-run.log
e2e-err.log
e2e-report.json
pw-test.log
test-batch*-final.log
api.log
api.err.log
api-restart.log
api-prod.log
api-prod.err
web.log
web.err.log
web-restart.log
web-prod.log
web-prod.err
perf-results.csv
yarn-debug.log*
yarn-error.log*
.pnp.*
.yarn/

# ---- Build artifacts ----
dist/
build/
.next/
out/
coverage/
*.tsbuildinfo

# ---- Env / secrets ----
.env
.env.local
.env.*.local
!.env.example
!.env.production.example

# ---- Local artifacts (not for repo) ----
screenshots/
# Runtime output của LocalFsAdapter (attachment upload) — xoá được, tự sinh lại.
var/
apps/*/var/
**/var/storage/

# ---- Editor ----
.vscode/
!.vscode/settings.json
!.vscode/extensions.json
.idea/
*.swp
*.swo

# ---- OS ----
Thumbs.db
.DS_Store

# ---- Prisma ----
apps/api/prisma/migrations/dev.db*

# ---- Test ----
junit.xml
test-results/
playwright-report/
playwright/.cache/

# ---- Docker volumes (host paths) ----
.pg_data/
.minio_data/
apps/api/cookies.txt
tsconfig.tsbuildinfo
*.tsbuildinfo
