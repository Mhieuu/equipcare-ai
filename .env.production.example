# =============================================================================
# EquipCare AI — Environment variables cho PRODUCTION
#
# Copy file này thành `.env` trên server rồi điền giá trị thật:
#   cp .env.production.example .env
#
# ⚠️  TUYỆT ĐỐI không commit `.env` — nó đã bị git-ignore.
# ⚠️  Không dùng lại giá trị "change-me" ở dưới — hãy sinh secret thật.
# =============================================================================

# ---- Runtime ----
# NODE_ENV=production: bắt buộc. Khiến:
#   - Swagger /docs bị ẩn
#   - Refresh cookie được set `secure: true` (chỉ truyền qua HTTPS)
#   - Demo credentials không hiện trên màn hình login
#   - Log chỉ ở mức error/warn
NODE_ENV=production

# APP_URL: origin(s) của frontend, cách nhau bằng dấu phẩy. Đây là allowlist
# CORS của API — thêm origin sai nghĩa là API không nhận request từ web.
# Ví dụ 2 domain: https://equipcare.vn,https://www.equipcare.vn
APP_URL=https://equipcare.vn

# Port nội bộ của API (reverse proxy sẽ forward tới đây).
API_PORT=3001

# ---- Database (PostgreSQL 16) ----
# Nếu DB chạy cùng host trong Docker Compose:
DATABASE_URL=postgresql://equipcare:THONG_DAU_MAT_KHAU_DAU_RAI_YEU@localhost:5432/equipcare
# Nếu DB ở máy khác: thay host + port, và nhớ mở firewall cho phép truy cập.

# ---- Auth ----
# ⚠️  BẮT BUỘC ≥ 32 bytes — app sẽ exit ngay khi boot nếu thiếu/sai.
# Sinh 2 secret khác nhau:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=change-me-min-32-chars-replace-with-random-hex-aaaaaaaaaaaa
REFRESH_TOKEN_PEPPER=change-me-min-32-chars-replace-with-random-hex-bbbbbbbbbbbb
ACCESS_TOKEN_TTL=900                 # 15 phút

# ---- AI ----
# "gemini" để dùng AI thật. Cần GEMINI_API_KEY hợp lệ (Google AI Studio).
AI_PROVIDER=gemini
AI_REQUEST_TIMEOUT_MS=45000
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
# true = lưu response AI vào DB để audit (khuyến nghị cho production).
AI_STORE_RESPONSES=true

# ---- Logging ----
LOG_LEVEL=info

# ---- Swagger ----
# /docs KHÔNG bật ở production. Đặt true tạm thời khi cần debug.
SWAGGER_ENABLED=false

# ---- Reverse proxy ----
# Số lớp proxy đứng trước API (1 = nginx/Caddy trực tiếp).
# Bật để rate limit tính theo IP thật của client, không phải IP của proxy.
TRUST_PROXY=1

# ---- Rate limit ----
# Mặc định đã đủ dùng. Nếu server chịu tải lớn, có thể nới RATE_LIMIT_MAX.
RATE_LIMIT_ENABLED=true
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=120
RATE_LIMIT_SHORT_MAX=20
RATE_LIMIT_AI_MAX=6

# ---- Scheduler ----
# Chu kỳ quét job định kỳ (ms). 60000 = 1 phút.
SCHEDULER_INTERVAL_MS=60000
