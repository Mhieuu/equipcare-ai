# =============================================================================
# EquipCare AI — Environment variables
# Copy this file to `.env` and fill in real values before running.
# Never commit `.env` — it is git-ignored.
# =============================================================================

# ---- Runtime ----
NODE_ENV=development
APP_URL=http://localhost:3000
API_URL=http://localhost:3001

# ---- Database (PostgreSQL 16) ----
DATABASE_URL=postgresql://equipcare:equipcare_pwd@localhost:5432/equipcare

# ---- Redis 7 (BullMQ + cache) ----
REDIS_URL=redis://localhost:6379

# ---- Auth ----
# IMPORTANT: secrets MUST be ≥ 32 bytes (Joi validation will fail-fast otherwise).
# Generate: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# Copy paste output here (96 hex chars from the command above).
JWT_ACCESS_SECRET=change-me-min-32-chars-replace-with-random-hex-aaaaaaaaaaaa
REFRESH_TOKEN_PEPPER=change-me-min-32-chars-replace-with-random-hex-bbbbbbbbbbbb
ACCESS_TOKEN_TTL=900                 # 15 minutes

# ---- Object storage (MinIO / S3-compatible) ----
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=equipcare-files
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin

# ---- AI ----
# Allowed values: "mock" | "openai"
AI_PROVIDER=mock
AI_REQUEST_TIMEOUT_MS=45000
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-2024-08-06
AI_STORE_RESPONSES=false

# ---- Logging ----
LOG_LEVEL=info
