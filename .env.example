# =============================================================================
# EquipCare AI — environment variables baseline (LOCKED v0.x)
# Copy to .env and adjust per environment. DO NOT commit real secrets.
# =============================================================================

# ----- Node / runtime -----
NODE_ENV=development

# ----- Database (PostgreSQL via docker-compose) -----
DATABASE_URL=postgresql://equipcare:equipcare_pwd@localhost:5432/equipcare
DB_USER=equipcare
DB_PASSWORD=equipcare_pwd
DB_NAME=equipcare

# ----- Redis (BullMQ) -----
REDIS_URL=redis://localhost:6379

# ----- MinIO (S3-compatible object storage) -----
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_REGION=us-east-1
S3_BUCKET=equipcare-files
S3_FORCE_PATH_STYLE=true

# ----- API -----
API_PORT=3001
API_BASE_URL=http://localhost:3001
JWT_SECRET=change-me-in-production-min-32-chars-long-secret-xxxxx
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d

# ----- Web (Next.js) -----
WEB_PORT=3000
NEXT_PUBLIC_API_URL=http://localhost:3001

# ----- Worker -----
WORKER_PORT=4000

# ----- AI provider -----
AI_PROVIDER=mock                # mock | openai
AI_REQUEST_TIMEOUT_MS=45000
# OPENAI_API_KEY=sk-...          # only when AI_PROVIDER=openai
# OPENAI_MODEL=gpt-4o-mini

# ----- Auth policy -----
MAX_LOGIN_ATTEMPTS=5
LOGIN_LOCKOUT_MINUTES=15

# ----- SLA / thresholds -----
MAINTENANCE_DUE_GRACE_HOURS=24

# ----- Logging -----
LOG_LEVEL=info
