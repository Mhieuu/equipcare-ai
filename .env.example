# =============================================================================
# EquipCare AI — Environment variables
# Copy this file to `.env` and fill in real values before running.
# Never commit `.env` — it is git-ignored.
# =============================================================================

# ---- Runtime ----
NODE_ENV=development
APP_URL=http://localhost:3000
API_URL=http://localhost:3001

# ---- Database (PostgreSQL 16) ----
DATABASE_URL=postgresql://equipcare:equipcare_pwd@localhost:5432/equipcare

# ---- Redis 7 (BullMQ + cache) ----
REDIS_URL=redis://localhost:6379

# ---- Auth ----
# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_ACCESS_SECRET=replace-me-with-64-byte-hex
REFRESH_TOKEN_PEPPER=replace-me-with-64-byte-hex
ACCESS_TOKEN_TTL=900                 # 15 minutes

# ---- Object storage (MinIO / S3-compatible) ----
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=equipcare-files
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin

# ---- AI ----
# Allowed values: "mock" | "openai"
AI_PROVIDER=mock
AI_REQUEST_TIMEOUT_MS=45000
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-2024-08-06
AI_STORE_RESPONSES=false

# ---- Logging ----
LOG_LEVEL=info
