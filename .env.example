# =====================================================
# EquipCare AI — environment variables template
# Copy to .env (NOT committed) and fill values.
# =====================================================

# ---- General ----
NODE_ENV=development
TZ=Asia/Ho_Chi_Minh

# ---- Postgres (matches infra/docker-compose.yml) ----
DATABASE_URL=postgresql://equipcare:equipcare@localhost:5432/equipcare?schema=public

# ---- Redis ----
REDIS_URL=redis://localhost:6379

# ---- API ----
API_PORT=3001
API_BASE_URL=http://localhost:3001
WEB_BASE_URL=http://localhost:3000
CORS_ORIGIN=http://localhost:3000

# ---- Auth ----
JWT_ACCESS_SECRET=change-me-to-a-32-char-random-secret
JWT_REFRESH_SECRET=change-me-to-another-32-char-random-secret
JWT_ACCESS_TTL_SECONDS=3600
JWT_REFRESH_TTL_SECONDS=2592000
BCRYPT_COST=12
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCKOUT_MINUTES=15

# ---- Web ----
NEXT_PUBLIC_API_BASE_URL=http://localhost:3001
NEXT_PUBLIC_WS_URL=ws://localhost:3001/ws

# ---- Storage (MinIO local) ----
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=equipcare-files
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_PRESIGN_TTL_SECONDS=300
S3_MAX_UPLOAD_BYTES=26214400
ATTACHMENT_STAGED_TTL_HOURS=24

# ---- AI ----
AI_PROVIDER=mock           # mock | openai
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
AI_REQUEST_TIMEOUT_MS=8000
AI_REQUEST_MAX_RETRIES=2
AI_CIRCUIT_BREAKER_THRESHOLD=5
AI_CIRCUIT_BREAKER_COOLDOWN_SECONDS=60

# ---- Notification ----
NOTIFICATION_POLL_FALLBACK_SECONDS=10

# ---- Mail (stub, log-only) ----
MAIL_PROVIDER=log          # log | smtp (smtp deferred)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=no-reply@equipcare.local